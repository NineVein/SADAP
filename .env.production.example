# =====================================================================
# DISKATmsa: contoh .env UNTUK PRODUKSI
# Salin menjadi .env di server, lalu isi semua nilai bertanda GANTI.
# JANGAN pernah commit berkas .env ke Git dan jangan kirim lewat chat/email.
# =====================================================================

APP_NAME=DISKATmsa
APP_ENV=production
APP_KEY=                      # jalankan: php artisan key:generate (sekali saja, jangan diganti setelah ada data)
APP_DEBUG=false
APP_URL=https://GANTI.domain.anda.go.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id

# Di belakang Nginx/Cloudflare/load balancer isi alamat IP-nya (pisahkan koma), atau * bila semua proxy tepercaya.
TRUSTED_PROXIES=

# --- Log: jangan catat detail (bisa memuat data pribadi) ---
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# --- Database: pakai pengguna khusus dengan hak terbatas, bukan root ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=diskatmsa
DB_USERNAME=GANTI_user_aplikasi
DB_PASSWORD=GANTI_password_kuat
# Lokasi mysqldump bila tidak ada di PATH (untuk backup), contoh: /usr/bin
DB_DUMP_PATH=

# --- Sesi dan cookie ---
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

# --- Verifikasi dua langkah (OTP lewat email): wajib untuk admin dan supervisor ---
# Membutuhkan email (MAIL_* di bawah) yang BENAR-BENAR terkirim. Uji dulu sebelum mewajibkan.
TWO_FACTOR_WAJIB=true

# --- Backup (lihat docs/BACKUP-DAN-PEMULIHAN.md) ---
# Folder tujuan backup, SEBAIKNYA di disk/server lain atau penyimpanan eksternal.
BACKUP_DISK_PATH=/var/backups/diskatmsa
# Sandi berkas zip backup (simpan di pengelola sandi, bukan hanya di server ini).
BACKUP_ARCHIVE_PASSWORD=GANTI_sandi_backup_panjang
BACKUP_NOTIFY_EMAIL=GANTI@email.anda

# --- Email (kode OTP login 2FA dan notifikasi backup gagal) ---
MAIL_MAILER=smtp
MAIL_HOST=GANTI
MAIL_PORT=587
MAIL_USERNAME=GANTI
MAIL_PASSWORD=GANTI
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@GANTI.domain
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
